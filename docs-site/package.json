{
  "name": "gwb-mineru-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gwb-mineru 的文档站：现状页的说法钉住仓里的源码，README、AGENTS 与 CLAUDE 由 render 生成到仓根",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --strictPort",
    "build": "react-router build",
    "start": "docsite-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "doc": "docfirst check",
    "doc:confirm": "docfirst confirm",
    "doc:render": "docfirst render"
  },
  "dependencies": {
    "@fumadocs/base-ui": "16.17.1",
    "@godcreator/code-pin": "0.2.1",
    "@godcreator/comments": "^0.1.3",
    "@godcreator/explainer": "0.1.1",
    "@godcreator/god-docsite": "^0.1.3",
    "@godcreator/identity": "^0.1.0",
    "@godcreator/trajectory": "0.1.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "isbot": "^5.2.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@godcreator/docfirst": "^0.1.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
