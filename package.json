{
  "name": "@godcreator/gwb-mineru",
  "version": "0.6.0",
  "author": {
    "name": "godcreator"
  },
  "description": "MinerU 转换件：提供 pdf2md 服务——PDF 经 MinerU 云端转 markdown，作业模式绕开总线 120s 红线（submit 秒回、后台跑完落盘）；token 凭据住 mineru 设置节。服务 gwbPdf2md；skill 1 份；命令 4 条。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-mineru.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "gwb": {
    "title": "PDF 转 markdown"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.18"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-data": "0.1.2",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-settings": "0.2.1",
    "@godcreator/gwb-skills": "0.4.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
