{
  "name": "@godcreator/gwb-mineru",
  "version": "0.1.0",
  "author": {"name": "godcreator"},
  "description": "MinerU 转换件：一个 gwb 件。提供 pdf2md 服务——PDF 经 MinerU 云端转 markdown，作业模式：submit 秒回、后台跑完落盘",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "gwb": {
    "title": "PDF 转 markdown"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": ">=0.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.18"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "0.4.0",
    "@godcreator/gwb-data": "0.1.1",
    "@godcreator/gwb-plugin-api": "0.1.1",
    "@godcreator/gwb-settings": "0.2.0",
    "@godcreator/gwb-skills": "0.4.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  }
}
