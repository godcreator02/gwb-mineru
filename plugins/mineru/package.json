{
  "name": "@godcreator/gwb-mineru",
  "version": "0.6.7",
  "author": {
    "name": "godcreator"
  },
  "description": "PDF 转 markdown 插件：提供 gwbPdf2md 服务与 pdf2md.* 命令，把 PDF 交给 MinerU 云端解析，提交后立即返回作业号，结果在后台落进调用方给的目录。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-mineru.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "gwb": {
    "title": "PDF 转 markdown",
    "provides": {
      "gwbPdf2md": {
        "summary": "PDF 转 markdown 的作业服务：PDF 经 MinerU 云端解析，markdown 与 images/ 落进调用方给的 outDir",
        "usage": "inject: ['gwbPdf2md']，ctx.gwbPdf2md.submit([{ input, outDir, overwrite? }, …]) 验完整批、落完账就回作业数组（返回不是完成，作业各自同时跑，终态经内核事件 { source: 'gwb-mineru', type: 'job-settled', jobId, ok, outDir, error? } 推出）；recover(id) 凭盘上原始 zip 重新解包、不花云端额度；get(id) 查一条（没有回 undefined）；list() 全部作业，新的在前。token 在设置节 mineru 的 token 键"
      }
    }
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-data": "^0.1.9",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.7",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "adm-zip": "^0.5.18",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.27.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
